### Voucher Claim Service - complete local flow
### File-level defaults let every request run without selecting an IntelliJ environment.
### Run requests from top to bottom. campaignId is read automatically from createCampaign.

@baseUrl = http://localhost:8080
@merchantId = 1000000000000001
@userId = 2000000000000001
@internalToken = local-internal-token

### 1. Create campaign
# @name createCampaign
POST {{baseUrl}}/api/v1/campaigns
Content-Type: application/json
X-Merchant-Id: {{merchantId}}
Idempotency-Key: {{$random.uuid}}}

{
  "name": "REST client priority campaign-phase3",
  "discountType": "PERCENTAGE",
  "discountValue": 12,
  "totalQuantity": 1000,
  "priorityOrder": "SCORE_DESC_THEN_REQUEST_MEMBER_DESC",
  "startAt": "2026-01-01T00:00:00Z",
  "endAt": "2030-01-01T00:00:00Z",
  "voucherExpiresAt": "2030-02-01T00:00:00Z"
}

> {%
    client.test("Campaign is created or replayed", function () {
        client.assert(response.status === 201 || response.status === 200,
            "Expected HTTP 201 or idempotent HTTP 200");
        client.assert(response.body.campaignId, "campaignId is missing");
    });
%}

### 2. Activate the campaign created above
# @name activateCampaign
POST {{baseUrl}}/api/v1/campaigns/activate
Content-Type: application/json
X-Merchant-Id: {{merchantId}}

{
  "campaignId": "01a04c4a-d9aa-7d45-9791-da3232826598"
}

> {%
    client.test("Campaign activation is durable", function () {
        client.assert(response.status === 202 || response.status === 200,
            "Expected HTTP 202 or replay HTTP 200");
        client.assert(response.body.status === "ACTIVATING" || response.body.status === "ACTIVE",
            "Expected ACTIVATING or ACTIVE");
    });
%}

### 3. Read campaign availability
# @name campaignStatus
GET {{baseUrl}}/api/v1/campaigns/status?campaignId=01a04c4a-d9aa-7d45-9791-da3232826598

> {%
    client.test("Campaign status is readable", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "ACTIVATING" || response.body.status === "ACTIVE",
            "Expected ACTIVATING or ACTIVE. Re-run this request until ACTIVE before claiming.");
    });
%}

### 4. Publish the mocked loyalty score
# @name publishScore
PUT {{baseUrl}}/api/v1/internal/score-snapshots
Content-Type: application/json
X-Internal-Token: {{internalToken}}

{
  "userId": "{{userId}}",
  "score": 900
}

> {%
    client.test("Score snapshot is accepted", function () {
        client.assert(response.status === 204, "Expected HTTP 204");
    });
%}

### 5. Claim a voucher
# @name createClaim
POST {{baseUrl}}/api/v1/claims
Content-Type: application/json

{
  "userId": "2000000000000005",
  "campaignId": "01a04b95-4284-7437-9f3d-b6cb228358a6"
}

> {%
    client.test("Claim operation is accepted or terminal", function () {
        client.assert(response.status === 202 || response.status === 200,
            "Expected asynchronous HTTP 202 or terminal replay HTTP 200");
        client.assert(response.body.requestId, "requestId is missing");
    });
%}

### 6. Read asynchronous claim status
# @name claimStatus
GET {{baseUrl}}/api/v1/claims/status?requestId={{createClaim.response.body.$.requestId}}

> {%
    client.test("Claim operation status is readable", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.requestId, "requestId is missing");
        client.assert(response.body.status, "status is missing");
    });
%}

### 7. Replay the natural claim operation
# @name replayClaim
POST {{baseUrl}}/api/v1/claims
Content-Type: application/json

{
  "userId": "{{userId}}",
  "campaignId": "{{createCampaign.response.body.$.campaignId}}"
}

> {%
    client.test("Natural idempotency returns the same operation", function () {
        client.assert(response.status === 202 || response.status === 200,
            "Expected HTTP 202 while processing or HTTP 200 when terminal");
        client.assert(response.body.requestId, "requestId is missing");
    });
%}

### 8. Read the user's durable claim after status becomes SUCCEEDED
# @name readClaim
GET {{baseUrl}}/api/v1/claims/me?campaignId={{createCampaign.response.body.$.campaignId}}
X-User-Id: {{userId}}

> {%
    client.test("Durable claim can be read", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.voucherCode, "voucherCode is missing");
    });
%}
