### Voucher Claim Service - validation and deterministic error examples
### File-level defaults let every request run without selecting an IntelliJ environment.
### These calls are independent and intentionally return errors.

@baseUrl = http://localhost:8080
@userId = 2000000000000001
@internalToken = local-internal-token

### Missing userId in body
# Expected: 400 INVALID_REQUEST
POST {{baseUrl}}/api/v1/claims
Content-Type: application/json

{
  "campaignId": "019c6fa6-5e22-7abc-9123-abcdef123456"
}

> {%
    client.test("Missing userId is rejected", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
        client.assert(response.body.code === "INVALID_REQUEST", "Expected INVALID_REQUEST");
    });
%}

### Missing campaignId in body
# Expected: 400 INVALID_REQUEST
POST {{baseUrl}}/api/v1/claims
Content-Type: application/json

{
  "userId": "{{userId}}"
}

> {%
    client.test("Missing campaignId is rejected", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
        client.assert(response.body.code === "INVALID_REQUEST", "Expected INVALID_REQUEST");
    });
%}

### Unauthorized internal score write
# Expected: 403 INVALID_INTERNAL_TOKEN
PUT {{baseUrl}}/api/v1/internal/score-snapshots
Content-Type: application/json
X-Internal-Token: wrong-token

{
  "userId": "{{userId}}",
  "score": 900
}

> {%
    client.test("Wrong internal token is rejected", function () {
        client.assert(response.status === 403, "Expected HTTP 403");
        client.assert(response.body.code === "INVALID_INTERNAL_TOKEN",
            "Expected INVALID_INTERNAL_TOKEN");
    });
%}
